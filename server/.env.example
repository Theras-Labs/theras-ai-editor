# Theras AI server. Copy to server/.env for local use. On Railway, set the same names as service variables.
PORT=4310

# Which AI provider the editor uses: openai, gemini or local. The admin can also change it at run time
# (Vibe Settings > Theras Server > Admin). A run-time change lasts until the server restarts.
AI_PROVIDER=openai

# OpenAI. OPENAI_MODEL is the default; OPENAI_MODELS is the list the admin can choose from.
# The editor can also ask for one model of the ACTIVE provider's list per request ("model" in the
# chat body; other values get HTTP 400), and for an "effort" (none, low, medium or high) that wins
# over the profile values below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.4,gpt-4.1,gpt-4.1-mini
# Voice input (speech to text) model.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Spoken replies (voice orb): text-to-speech model and voice.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Optional: minimal, low, medium or high. Leave empty for the model default.
# General fallback for requests that have no profile-specific value.
OPENAI_REASONING_EFFORT=
# Reasoning effort by request profile. profile "compose" uses OPENAI_EFFORT_COMPOSE (default none).
# Other profiles use OPENAI_EFFORT_EDIT, then OPENAI_REASONING_EFFORT, else the model default.
# If the model rejects a value, the request fails with the provider error (no retry).
OPENAI_EFFORT_COMPOSE=none
OPENAI_EFFORT_EDIT=

# Gemini (optional second provider).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-pro-preview

# Local or other OpenAI-compatible provider (Chat Completions, streamed). "local" is available
# when LOCAL_BASE_URL and a model are set. Examples: Ollama http://127.0.0.1:11434/v1,
# LM Studio http://127.0.0.1:1234/v1. LOCAL_API_KEY is optional (sent as a Bearer token).
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_MODELS=
LOCAL_API_KEY=

# Admin token for the run-time switch. 16 characters or more, or the admin route stays off.
ADMIN_TOKEN=

# Comma-separated browser origins. Empty = any localhost or 127.0.0.1 origin (local development only).
ALLOWED_ORIGINS=

# Abuse limits per client IP (in memory, no database).
AI_RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_DAY=1500

# Hosted demo quota, in prompts (one user message with all of its model steps), per UTC day.
# 0 or empty = no limit (the default, for a local run with your own key).
AI_PROMPTS_PER_IP_PER_DAY=
AI_PROMPTS_PER_DAY=
# Model calls that one prompt may make (director plus tool loop steps).
AI_CALLS_PER_PROMPT=
# Optional end of the hosted AI, as an ISO date and time, for example 2026-12-01T00:00:00Z.
AI_DEMO_ENDS_AT=
