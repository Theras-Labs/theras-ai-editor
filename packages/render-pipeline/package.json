  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theras-Labs/theras-ai-editor.git",
    "directory": "packages/render-pipeline"
  },
  "bugs": {
    "url": "https://github.com/Theras-Labs/theras-ai-editor/issues"
  },
  "homepage": "https://github.com/Theras-Labs/theras-ai-editor/tree/main/packages/render-pipeline",
  "dependencies": {
    "@theras/geometry-kernel": "workspace:*",
    "@theras/shared": "workspace:*",
    "earcut": "^3.0.2",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.2"
  }
}
