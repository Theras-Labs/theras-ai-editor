{
  "name": "@theras/render-pipeline",
  "version": "0.1.12",
  "description": "Render-facing scene derivation and viewport data structures for Theras.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
