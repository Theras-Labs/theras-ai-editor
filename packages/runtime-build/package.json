{
  "name": "@theras/runtime-build",
  "version": "0.1.12",
  "description": "Headless build utilities and CLI for compiling Theras runtime bundles.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "theras-runtime-build": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config ../../scripts/tsup.package.config.mjs",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theras-Labs/theras-ai-editor.git",
    "directory": "packages/runtime-build"
  },
  "bugs": {
    "url": "https://github.com/Theras-Labs/theras-ai-editor/issues"
  },
  "homepage": "https://github.com/Theras-Labs/theras-ai-editor/tree/main/packages/runtime-build",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.183.1"
  },
  "dependencies": {
    "@theras/editor-core": "workspace:*",
    "@theras/geometry-kernel": "workspace:*",
    "@theras/runtime-format": "workspace:*",
    "@theras/shared": "workspace:*",
    "earcut": "^3.0.2",
    "fflate": "^0.8.2",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.2"
  }
}
